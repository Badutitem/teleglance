# TeleGlance backend environment — copy to .env, never commit the real file.
# Telegram bot token from @BotFather. Empty = demo mode (seed digest, demo-log sends).
TELEGRAM_BOT_TOKEN=
# Port for the backend HTTP API.
PORT=8787
# Pairing token the glasses app presents on /send and /chats/write.
# Development default is "teleglance-dev"; set a real value for any shared use.
PAIRING_TOKEN=teleglance-dev
# Read-only mode: 1 = digest still builds but /send always refuses.
# TELEGLANCE_READ_ONLY=
# SQLite path (default: backend/data/teleglance.sqlite).
# TELEGLANCE_DB=
